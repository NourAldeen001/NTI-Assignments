<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.0">

    <entity class="org.example.models.Author">
        <attributes>
            <one-to-many name="books" target-entity="org.example.models.Book" mapped-by="author" orphan-removal="true">
                <cascade><cascade-all/></cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="org.example.models.Book">
        <attributes>
            <many-to-one name="author" target-entity="org.example.models.Author">
                <join-column name="author_id"/>
            </many-to-one>
        </attributes>
    </entity>

</entity-mappings>